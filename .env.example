# cp .env.example .env 后按这台机器填；# 开头是注释，没写的用默认值。
APITRACK_RUNNER_URL=https://apitrack.example.com
APITRACK_RUNNER_TOKEN=apirunner_xxxxxxxxxxxxxxxx

# 这台机器所在的网段/分区（必须是 Token 允许的标签子集，逗号分隔）
APITRACK_RUNNER_LABELS=default

# 可选：
# APITRACK_RUNNER_NAME=office-runner-01
# APITRACK_RUNNER_CAPACITY=1
# APITRACK_RUNNER_DATA_DIR=/var/lib/apitrack-runner
# APITRACK_RUNNER_SHUTDOWN_GRACE_SECONDS=30
# 平台在自签证书反代后面时给一个 PEM 路径（start.sh 会注入 NODE_EXTRA_CA_CERTS）
# APITRACK_RUNNER_CA_BUNDLE=/etc/ssl/corp-ca.pem
